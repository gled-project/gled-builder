########################################################################
# Configuration variables
########################################################################

PREFIX  := @prefix@

CACHE_DIR := @CACHE_DIR@
CACHE_TAG := @CACHE_TAG@
CACHE_URL := @CACHE_URL@

GLED_REPO     := @GLED_REPO@
GLED_REF      := @GLED_REF@
GLED_HEP_REPO := @GLED_HEP_REPO@
GLED_HEP_REF  := @GLED_HEP_REF@

GTS_CXX_REPO  := @GTS_CXX_REPO@
GTS_CXX_REF   := @GTS_CXX_REF@

MAKE_J_OPT   := @MAKE_J_OPT@

BUILD        := @build@
BUILD_CPU    := @build_cpu@
BUILD_VENDOR := @build_vendor@
BUILD_OS     := @build_os@

DISTRO_VENDOR  := @distro_vendor@
DISTRO_NAME    := @distro_name@
DISTRO_VERSION := @distro_version@

CC  := @CC@
CXX := @CXX@
CPP := @CPP@

CC_VERSION := @CC_VERSION@
CC_MAJOR   := @CC_MAJOR@
CC_MINOR   := @CC_MINOR@

GB_CPPFLAGS := @CPPFLAGS@
GB_CFLAGS   := @CFLAGS@
GB_CXXFLAGS := @CXXFLAGS@
GB_LDFLAGS  := @LDFLAGS@
GB_LIBSETS  := @LIBSETS@

EXTRA_PATHS := @EXTRA_PATHS@

ROOT_GLED_DEBUG := @ROOT_GLED_DEBUG@

########################################################################
# Common variables
########################################################################

ifdef GLED_ECHO_CMDS
MUTE:=
else
MUTE:=@
endif
ifdef GLED_QUIET
ECHO:=@echo > /dev/null
else
ECHO:=@echo
endif
